<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'none'"><style>
:root{--header:{{ layout.header_color or organization.header_color }};--accent:{{ organization.accent }}}
*{box-sizing:border-box}body{font-family:Arial,'Noto Sans',sans-serif;color:#173247;font-size:10px;line-height:1.5;margin:0}h1{font-size:23px;line-height:1.25}h2{font-size:15px;break-after:avoid;color:var(--header)}p{white-space:pre-wrap}.brand{background:var(--header);color:white;padding:14px;display:flex;justify-content:space-between;gap:20px}.mast{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:20px 0;border-bottom:2px solid var(--accent)}.mast img{max-height:60px;max-width:130px;object-fit:contain}.mast strong{font-size:15px}.subtitle{color:#536e7f}.metadata{margin:18px 0}table{width:100%;border-collapse:collapse;table-layout:fixed;margin:12px 0 20px;overflow-wrap:anywhere}th{background:var(--header);color:white;text-align:left;padding:9px}td{vertical-align:top;padding:8px;white-space:pre-wrap;border-bottom:1px solid #e0e8ec}.striped tbody tr:nth-child(even){background:#f1f7f8}.grid td,.grid th{border:1px solid #d4e0e6}.minimal td{border:0}.flow,.flow-section{break-inside:avoid}.flow svg{width:100%;height:auto;max-height:680px}.watermark{position:fixed;top:45%;left:0;width:100%;text-align:center;transform:rotate(-35deg);font-size:42px;color:rgba(18,47,67,.12);z-index:1000;pointer-events:none;white-space:nowrap}.footer{border-top:1px solid var(--accent);padding-top:10px;font-size:9px;color:#526e7e}thead{display:table-header-group}tr{break-inside:avoid}section{margin-top:18px}.sample{font-size:11px;color:#7d4a0b}
</style></head><body>
{% if not approved %}<div class="watermark">DRAFT - NOT APPROVED</div>{% endif %}
<div class="brand"><strong>{{ organization.name }} / {{ organization.department }} / {{ organization.team }}</strong><span>{{ layout.header or organization.header }}</span></div>
<div class="mast"><div>{% if layout.show_company_logo and organization.logo_data %}<img src="{{ organization.logo_data }}" alt="Company logo">{% else %}<strong>{{ organization.name }}</strong>{% endif %}<div>{{ organization.address }}</div></div><div><strong>{{ title }}</strong><div class="subtitle">{{ project_name }}</div></div><div>{% if layout.show_customer_logo and customer.logo_data %}<img src="{{ customer.logo_data }}" alt="Customer logo">{% endif %}<div>{{ customer.name }}</div></div></div>
<h1>{{ title }}</h1><p class="subtitle">{{ number }} / {{ revision }}</p>
{% if layout.show_metadata and metadata %}<table class="metadata {{ layout.table_style }}"><thead><tr><th>Document field</th><th>Value</th></tr></thead><tbody>{% for row in metadata %}<tr><td>{{ row[0] }}</td><td>{{ row[1] }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% for key in layout.sections %}{% for section in sections %}{% if section.key==key and (key!='signatures' or layout.show_signatures) %}<section class="{% if key=='flowchart' %}flow-section{% endif %}"><h2>{{ section.title }}</h2>{% if section.text %}<p>{{ section.text }}</p>{% endif %}{% if section.rows %}<table class="{{ layout.table_style }}"><thead><tr>{% for col in section.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead><tbody>{% for row in section.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>{% endif %}{% if section.svg %}<div class="flow">{{ section.svg | safe }}</div>{% endif %}</section>{% endif %}{% endfor %}{% endfor %}
<div class="footer">{{ layout.footer or organization.footer }} / {{ number }} / {{ revision }}</div></body></html>
