<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'none'"><style>
*{box-sizing:border-box}body{font-family:Arial,'Noto Sans',sans-serif;font-size:9.5px;color:#132d49;margin:0;line-height:1.35}h1,h2,p{margin:0}header{display:flex;align-items:center;gap:24px;padding:10px 0 12px;border-bottom:4px solid #7bc5ed;background:linear-gradient(125deg,#fff,#eaf5ff)}header img{max-width:140px;max-height:60px}header strong{font-size:25px;color:#195b98}h1{font-size:22px;color:#0d2547}header p{font-size:13px;margin-top:5px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:4px 18px;background:#f1f7ff;border:1px solid #a9c6e5;border-radius:5px;padding:8px;margin:10px 0}.meta b{display:inline-block;min-width:95px}section{border:1px solid #aac6e4;border-radius:6px;margin:7px 0;break-inside:avoid;overflow:hidden}h2{font-size:13px;padding:6px 10px;background:linear-gradient(100deg,{{ layout.header_color or '#20568f' }},#d9e8fc);color:#fff}section>p{white-space:pre-wrap;padding:9px 10px}table{width:100%;border-collapse:collapse;table-layout:fixed;overflow-wrap:anywhere}th,td{padding:4px 6px;border:1px solid #c5d6e9;white-space:pre-wrap;text-align:left;vertical-align:top}th{background:#e0ecfa;color:#163454;font-weight:700}tr{break-inside:avoid}thead{display:table-header-group}.pair{display:grid;grid-template-columns:1fr 1fr;gap:14px}.pair section{margin:0}.draft{position:fixed;left:0;right:0;top:45%;text-align:center;font-size:35px;transform:rotate(-30deg);color:#214d7a15;pointer-events:none}.footer{font-size:8px;border-top:1px solid #b3cbe6;padding-top:7px;color:#58728b}.signoff td:first-child{font-weight:bold}.mom-signature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:10px}.mom-signature-grid>div{border-right:1px solid #aac6e4;padding:0 8px}.mom-signature-grid>div:last-child{border:0}.mom-signature-grid strong,.mom-signature-grid b,.mom-signature-grid small{display:block;margin:3px 0}.mom-signature-grid strong{color:#175a9c}.stamp{font-size:8px;color:#526b85}.audit-appendix{break-before:page}.audit-appendix:empty{display:none}
</style></head><body>{% if not approved %}<div class="draft">DRAFT - NOT APPROVED</div>{% endif %}
<header><div>{% if organization.logo_data and layout.show_company_logo %}<img src="{{ organization.logo_data }}" alt="Company logo">{% else %}<strong>{{ organization.name or 'uSOPp.ai' }}</strong>{% endif %}</div><div><h1>Minutes of Meeting (MOM)</h1><p>Project Discussion &amp; Action Tracker</p></div></header>
<div class="meta"><div><b>MOM No.</b>{{ number }}</div><div><b>Revision</b>{{ revision }}</div><div><b>Project Name</b>{{ project_name }}</div><div><b>Customer</b>{{ customer.name }}</div></div>
{% macro show(section) %}<section class="{% if section.key=='signatures' %}signoff{% endif %}"><h2>{{ section.title }}</h2>{% if section.text %}<p>{{ section.text }}</p>{% endif %}{% if section.title=='Approval' %}<div class="mom-signature-grid">{% for row in section.rows %}<div><strong>{{ row[0] }}</strong><b>{{ row[1] }}</b><small>{{ row[2] }}</small><small>Date: {{ row[3][:10] or 'Pending' }}</small></div>{% endfor %}</div>{% elif section.columns %}<table><thead><tr>{% for col in section.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead><tbody>{% for row in section.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ section.columns|length }}">Not recorded</td></tr>{% endfor %}</tbody></table>{% endif %}</section>{% endmacro %}
{% for section in sections %}{% if section.key=='summary' and section.key in layout.sections %}{{ show(section) }}{% endif %}{% endfor %}
<div class="pair">{% for section in sections %}{% if section.key in ['scope','purpose'] and section.key in layout.sections %}{{ show(section) }}{% endif %}{% endfor %}</div>
{% for section in sections %}{% if section.key not in ['summary','scope','purpose','details'] and section.title!='Review Audit Stamps' and section.key in layout.sections and (section.key!='signatures' or layout.show_signatures) %}{{ show(section) }}{% endif %}{% endfor %}
<div class="audit-appendix">{% for section in sections %}{% if (section.key=='details' or section.title=='Review Audit Stamps') and section.key in layout.sections and (section.key!='signatures' or layout.show_signatures) %}{{ show(section) }}{% endif %}{% endfor %}</div>
<div class="footer">{{ layout.footer or organization.footer }} · {{ number }} · {{ revision }}</div></body></html>
