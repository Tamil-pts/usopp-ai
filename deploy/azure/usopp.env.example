# systemd reads this file; .env is not loaded automatically by Uvicorn.
USOPP_DATA_ROOT=/var/lib/usopp
# Keep engine-job concurrency independent from the number of user accounts.
USOPP_MAX_PARALLEL_TESTS=5
# Optional AI settings can be added after deployment.
# USOPP_LLM_PROVIDER=ollama
# USOPP_LLM_BASE_URL=http://127.0.0.1:11434
# USOPP_LLM_MODEL=qwen3:8b
# Do not store the initial Admin password here; initialize it offline.
