# Combine with the existing deployment environment. Do not commit local.env.
USOPP_PI_MODEL_DIRECTORY=/srv/usopp/intelligence-models
USOPP_PI_PUBLIC_ORIGIN=https://workhub.company.internal
USOPP_PI_REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_HEX_SECRET
USOPP_PI_LLM_THREADS=4
USOPP_PI_WHISPER_THREADS=2
# The default deployment has one worker and uses the existing private model.
# For the optional local-inference profile, use http://project-llm:8080.
USOPP_PI_LLM_URL=
USOPP_PI_WORKER_CONCURRENCY=1
USOPP_PI_AI_CONCURRENCY=1
USOPP_PI_WORKER_MEMORY=3g
USOPP_PI_WORKER_CPUS=2
USOPP_PI_JOB_MAX_MEMORY_MB=2048
USOPP_PI_JOB_TIMEOUT=1800
USOPP_PI_SPEECH_TIMEOUT=3600
USOPP_PI_MEMORY_RESERVE_MB=256
USOPP_PI_DISK_RESERVE_MB=512
USOPP_PI_MAX_PENDING=100
USOPP_PI_MAX_PROJECT_PENDING=20
# Redis is optional. Only enable queue-wakeup with a secret and an internal URL.
USOPP_PI_REDIS_URL=
# Optional office profile: select a reviewed version and check its license/capacity.
USOPP_PI_OFFICE_IMAGE=onlyoffice/documentserver:REPLACE_WITH_REVIEWED_TAG
USOPP_PI_OFFICE_PUBLIC_URL=https://office.company.internal
USOPP_PI_OFFICE_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_HEX_SECRET
USOPP_PI_OFFICE_PORT=8202
