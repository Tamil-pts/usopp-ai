{
  "name": "usopp-ai-v4",
  "private": true,
  "version": "4.99.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:install": "python3 scripts/ubuntu_demo.py install",
    "start": "python3 scripts/ubuntu_demo.py start",
    "stop": "python3 scripts/ubuntu_demo.py stop",
    "restart": "python3 scripts/ubuntu_demo.py restart",
    "status": "python3 scripts/ubuntu_demo.py status",
    "logs": "python3 scripts/ubuntu_demo.py logs",
    "prebuild": "node scripts/build_nami.mjs --install-only",
    "build": "tsc -b && npm run build:compare-report && vite build && npm run build:nami && npm run build:virtual-plc",
    "build:compare-report": "node scripts/build_compare_report.mjs",
    "preview": "vite preview",
    "build:nami": "node scripts/build_nami.mjs",
    "build:virtual-plc": "tsc --noEmit --strict --jsx react-jsx --module ESNext --moduleResolution bundler --target ES2022 --lib ES2022,DOM --skipLibCheck --esModuleInterop virtual_plc/ui/src/main.tsx && vite build --config virtual_plc/vite.config.ts"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "12.12.0",
    "echarts": "6.1.0",
    "lucide-react": "^0.468.0",
    "mermaid": "11.17.2",
    "pagedjs": "0.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-grid-layout": "2.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
}
