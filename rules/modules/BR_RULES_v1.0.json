      ],
      "subroutine": "mms_nw_rCyclic.st",
      "category": "Logic / declaration",
      "expected": "Declare Alarm_EN_Delay as DINT and assign it the value 250.",
      "kind": "exact_logic_declaration",
      "needsLogicConfiguration": false,
      "logicAlternatives": [
        "Alarm_EN_Delay := 250;"
      ],
      "exactLogic": "Alarm_EN_Delay := 250;",
      "variable": "Alarm_EN_Delay",
      "allowedDatatypes": [
        "DINT"
      ],
      "description": "Alarm Timeout delay",
      "featureName": "Spin Connect",
      "featureId": "spin_connect",
      "machineScope": [
        "All"
      ],
      "moduleId": "BR_RULES"
    },
