  "rules": [
    {
      "id": "BR_RULE-001",
      "name": "MMS_Alarm_time out_default_value",
      "version": "1.0",
      "enabled": false,
      "reviewStatus": "Needs engineer review",
      "machineDepartment": "All",
      "machineModels": [
        "All"
      ],
      "subroutine": "mms_nw_rCyclic.st",
      "category": "Logic with condition",
      "expected": "One accepted receive-timeout variable is at or below 30; set that same variable to 250.",
      "kind": "condition_assignment",
      "needsLogicConfiguration": false,
      "logicAlternatives": [
        "IF HMI_read_recv_timeout_time <= 30 THEN\n    HMI_read_recv_timeout_time := 250;\nEND_IF",
        "IF HMI_recv_timeout_time <= 30 THEN\n    HMI_recv_timeout_time := 250;\nEND_IF",
        "IF Read_recv_timeout_time <= 30 THEN\n    Read_recv_timeout_time := 250;\nEND_IF"
      ],
      "exactLogic": "IF HMI_read_recv_timeout_time <= 30 THEN\n    HMI_read_recv_timeout_time := 250;\nEND_IF",
      "variable": "HMI_read_recv_timeout_time",
      "acceptedVariables": [
        "HMI_read_recv_timeout_time",
        "HMI_recv_timeout_time",
        "Read_recv_timeout_time"
      ],
      "comparison": "<=",
      "threshold": 30,
      "assignedValue": 250,
      "description": "Alarm Receive Timeout",
      "featureName": "Spin Connect",
      "featureId": "spin_connect",
      "machineScope": [
        "All"
      ],
      "moduleId": "BR_RULES"
    },
    {
      "id": "BR_RULE-002",
